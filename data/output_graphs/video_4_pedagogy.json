        {
            "original_term": "\u0938\u092c\u0938\u0947 \u0907\u0902\u092a\u094b\u0930\u094d\u091f\u0947\u0902\u091f \u091a\u0940\u091c \u0906\u092a\u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0928\u0940 \u0939\u0948",
