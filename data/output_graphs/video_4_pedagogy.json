        {
            "original_term": "\u092a\u094b\u0908 \u091c\u093f\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948 cram \u0915\u0930\u0928\u0947 \u0915\u0940",
